# Firebase web app config (Console → Project settings → Your apps)
VITE_FIREBASE_APIKEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGE_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# FCM web push (Console → Cloud Messaging → Web Push certificates)
VITE_FIREBASE_VAPID_KEY=

# Encrypts Zustand persist in IndexedDB. Required for production builds.
# Generate e.g.: openssl rand -base64 32
VITE_ZUSTAND_STORAGE_KEY=

# Companion portfolio API origin (replies / test-push). Leave empty to use same-origin /api proxy in dev.
VITE_PORTFOLIO_API_URL=
