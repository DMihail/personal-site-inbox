rules_version = '2';

// Deploy: firebase deploy --only firestore:rules
// Single-operator inbox: restrict Firebase Auth sign-up in Console; use INBOX_ALLOWED_UIDS on the API.
service cloud.firestore {
  match /databases/{database}/documents {
    match /messages/{messageId} {
      allow read, delete: if request.auth != null;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['read', 'archived', 'important']);
      allow create: if false;
    }

    match /fcmTokens/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      match /devices/{deviceId} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && deviceId.matches('^[a-zA-Z0-9_-]{8,64}$')
          && request.resource.data.uid == uid
          && request.resource.data.keys().hasOnly(['token', 'uid', 'updatedAt', 'platform', 'userAgent'])
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0
          && request.resource.data.token.size() <= 4096
          && request.resource.data.platform in ['ios', 'android', 'desktop', 'unknown']
          && request.resource.data.userAgent is string
          && request.resource.data.userAgent.size() <= 200;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
